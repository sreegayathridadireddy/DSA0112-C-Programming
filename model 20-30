//friendly pair numbers 220 and 284

#include <iostream>
using namespace std;

int sumOfDivisors(int n) {
    int sum = 0;
    for (int i = 1; i < n; i++) {
        if (n % i == 0) {
            sum += i;
        }
    }
    return sum;
}

int main() {
    int a, b;
    cout << "Enter two numbers: ";
    cin >> a >> b;

    if (sumOfDivisors(a) == b && sumOfDivisors(b) == a) {
        cout << a << " and " << b << " are friendly pairs." << endl;
    } else {
        cout << a << " and " << b << " are not friendly pairs." << endl;
    }

    return 0;
}


