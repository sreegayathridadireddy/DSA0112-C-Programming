//Sum of exponential series up to nth term

#include <iostream>
using namespace std;

int main() {
    double x;
    int n;
    double sum = 1.0, term = 1.0;

    cout << "Enter the value of x: ";
    cin >> x;
    cout << "Enter the number of terms (n): ";
    cin >> n;

    for (int i = 1; i <= n; i++) {
        term *= x / i;
        sum += term;
    }

    cout << "Sum: " << sum << endl;

    return 0;
}


//Identify subarray within the array whose elements sum up to given target value


#include <iostream>
#include <vector>
using namespace std;

int main() {
    vector<int> arr = {1, 2, 3, 7, 5};
    int target;

    cout << "Enter the target sum: ";
    cin >> target;

    for (int start = 0; start < arr.size(); start++) {
        int sum = 0;
        for (int end = start; end < arr.size(); end++) {
            sum += arr[end];
            if (sum == target) {
                cout << "Subarray found between indices " << start << " and " << end << endl;
                return 0;
            }
        }
    }

    cout << "No subarray found." << endl;
    return 0;
}


