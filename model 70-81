//Print time in 12hr format

#include <iostream>
#include <ctime>
using namespace std;

int main() {
    time_t now = time(0);
    tm *ltm = localtime(&now);

    int hour = ltm->tm_hour % 12;
    int minute = ltm->tm_min;
    int second = ltm->tm_sec;
    string period = (ltm->tm_hour >= 12) ? "PM" : "AM";

    if (hour == 0) hour = 12;

    cout << "Current time: " << hour << ":" << minute << ":" << second << " " << period << endl;

    return 0;
}


