#include <iostream>
#include <climits>
using namespace std;

int main() {
    int n, digit, smallest = INT_MAX, largest = INT_MIN;
    cout << "Enter a number: ";
    cin >> n;

    while (n != 0) {
        digit = n % 10;
        if (digit < smallest) {
            smallest = digit;
        }
        if (digit > largest) {
            largest = digit;
        }
        n /= 10;
    }

    cout << "Smallest digit: " << smallest << endl;
    cout << "Largest digit: " << largest << endl;
    return 0;
}



