#include <iostream>
#include <string>
using namespace std;

class BankAccount {
    string accountHolder;
    int accountNumber;
    double balance;

public:
    BankAccount(string holder, int number, double bal) {
        accountHolder = holder;
        accountNumber = number;
        balance = bal;
