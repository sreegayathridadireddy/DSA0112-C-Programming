//Operator overloading(XOR)


#include<iostream>
using namespace std;
class num{
	public:
		int value;
		
		num(int v){
			value=v;
		}
		
		num operator^(num other){
			return num(value^other.value);
		}
};
int main(){
	num num1(5);
	num num2(3);
	
	num result=num1^num2;
	
	cout<<"Result of xor "<<result.value<<endl;
	
	return 0;
}


//Sum of odd and even numbers

#include<iostream>
using namespace std;
int main(){
	int evensum=0, oddsum=0, num;
	
	cout<<"Enter numbers (enter -1 to stop) ";
	
	while(true){
		cin>>num;
		if(num==-1)
		break;
		if(num%2==0)
		evensum=evensum+num;
		else
		oddsum=oddsum+num;
		
	}
	cout<<"sum of even sum is : "<<evensum<<endl;
	cout<<"sum of odd sum is : "<<oddsum<<endl;
	return 0;
}

//sum of the boundarysum of the matrix

#include<iostream>
using namespace std;
int main(){
	int rows,cols;
	cout<<"Enter the number of rows and col: ";
	cin>>rows>>cols;
	
	int matrix[10][10];
	cout<<"Enter the elements of the matrix:\n";
	for(int i=0;i<rows;i++){
		for(int j=0;j<cols;j++){
			cin>>matrix[i][j];
		}
	}
	
	int boundarysum=0;
	for(int i=0;i<rows;i++){
		for(int j=0;j<cols;j++){
			if(i==0||i==rows-1||j==0||j==cols-1){
				boundarysum+=matrix[i][j];
			}
		}
	}
	cout<<"The sum of the boundary is :"<<boundarysum<<endl;
	return 0;
}


//matrix rotate in 180 degrees

#include<iostream>
using namespace std;
int main(){
	int matrix[3][3];
	
	cout<<"Enter the matrix elements:\n";
	for(int i=0;i<3;i++){
		for(int j=0;j<3;j++){
			cin>>matrix[i][j];
		}
	}
	
	cout<<"Rotate it into 180 degrees:\n";
	for(int i=2;i>=0;i--){
		for(int j=2;j>=0;j--){
			cout<<matrix[i][j]<<" ";
		}
		cout<<endl;
	}
	return 0;
}

//Sort the characters in alphabetical order

#include <iostream>
using namespace std;

int main() {
    string input;

    cout << "Enter a string: ";
    cin >> input;
    for (int i = 0; i < input.length(); i++) {
        for (int j = i + 1; j < input.length(); j++) {
            if (input[i] > input[j]) {
                char temp = input[i];
                input[i] = input[j];
                input[j] = temp;
            }
        }
    }
    cout << "Sorted string: " << input << endl;

    return 0;
}


//Fibonacci series


#include <iostream>
using namespace std;

// Function to calculate Fibonacci number recursively
int fib(int n) {
    if (n == 1) {
        return 0;
    } else if (n == 2) {
        return 1;
    } else {
        return fib(n-1) + fib(n-2);
    }
}

int main() {
    int n;
    cout << "Enter the value of N: ";
    cin >> n;

    cout << "Fibonacci number is " << fib(n) << endl;

    return 0;
}


//Sum of square of n natural numbers


#include <iostream>
using namespace std;

int main() {
    int n;

    cout << "Enter a natural number: ";
    cin >> n;

    int sum = 0;

    for (int i = 1; i <= n; i++) {
        sum += i * i;
    }

    cout << "Sum of squares of first " << n << " natural numbers: " << sum << endl;

    return 0;
}


//Full diamond using for loop


#include <iostream>
using namespace std;

int main() {
    int n;

    cout << "Enter the number of rows for the diamond (half): ";
    cin >> n;

    // Upper part of the diamond
    for (int i = 1; i <= n; i++) {
        for (int j = 1; j <= n - i; j++) {
            cout << " ";
        }
        for (int j = 1; j <= 2 * i - 1; j++) {
            cout << "*";
        }
        cout << endl;
    }

    for (int i = n - 1; i >= 1; i--) {
        for (int j = 1; j <= n - i; j++) {
            cout << " ";
        }
        for (int j = 1; j <= 2 * i - 1; j++) {
            cout << "*";
        }
        cout << endl;
    }

    return 0;
}
