#include <iostream>
using namespace std;

void sortArray(int* arr, int size) {
    for (int i = 0; i < size - 1; i++) {
        for (int j = 0; j < size - i - 1; j++) {
            if (*(arr + j) > *(arr + j + 1)) {
                
                int temp = *(arr + j);
                *(arr + j) = *(arr + j + 1);
                *(arr + j + 1) = temp;
            }
        }
    }
}

int main() {
    int arr[100], num, count = 0;

    cout << "Enter Infinite Numbers and (-1 To Stop Reading)" << endl;
    while (true) {
        cin >> num;
        if (num == -1) {
            break;
        }
        arr[count] = num;
        count++;
    }

    sortArray(arr, count);

    cout << "The Ascending order is given below:" << endl;
    for (int i = 0; i < count; i++) {
        cout << arr[i] << endl;
    }

    return 0;
}

