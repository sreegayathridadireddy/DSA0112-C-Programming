#include <iostream>
using namespace std;

class Shape {
public:
    Shape(double radius) {
        cout << "Area of Circle: " << 3.14 * radius * radius << endl;
    }
    Shape(double length, double breadth) {
        cout << "Area of Rectangle: " << length * breadth << endl;
    }
    Shape(double base, double height, int triangle) {
        cout << "Area of Triangle: " << 0.5 * base * height << endl;
    }
};

int main() {
    Shape circle(5);           
    Shape rectangle(4, 6);     
    Shape triangle(4, 5, 1);   

    return 0;
}
