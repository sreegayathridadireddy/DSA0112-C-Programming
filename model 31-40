#include <iostream>
using namespace std;

int main() {
    int n = 3;
    int matrix[3][3] = { {1, 0, 0}, {0, 1, 0}, {0, 0, 1} };
    bool isIdentity = true;

    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            if ((i == j && matrix[i][j] != 1) || (i != j && matrix[i][j] != 0)) {
                isIdentity = false;
            }
        }
    }

    cout << (isIdentity ? "Identity Matrix" : "Not an Identity Matrix") << endl;
    return 0;
}

