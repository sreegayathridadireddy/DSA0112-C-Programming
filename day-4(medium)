#include <iostream>
using namespace std;

void findGreatest(int* p1, int* p2, int* p3) {
    int greatest;

    if (*p1 >= *p2 && *p1 >= *p3) {
        greatest = *p1;
    } else if (*p2 >= *p1 && *p2 >= *p3) {
        greatest = *p2;
    } else {
        greatest = *p3;
    }

    cout << "The greatest is P2: " << greatest << endl;
}

int main() {
    int num1, num2, num3;
    cout << "Enter the three numbers: " << endl;
    cin >> num1 >> num2 >> num3;

    findGreatest(&num1, &num2, &num3);

    return 0;
}

