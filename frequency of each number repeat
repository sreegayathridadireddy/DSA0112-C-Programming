#include<iostream>
using namespace std;
int main(){
	int n,digit;
	int freq[10]={0};
	
	cout<<"Enter the number: ";
	cin>>n;
	
	while(n>0){
		digit=n%10;
		freq[digit]++;
		n=n/10;
	}
	cout<<"frequency of number is\n";
	for(int i=0;i<10;i++){
		if(freq[i]>0){
			cout<<"digit "<<i<<"appears "<<freq[i]<<"times.\n";
		}
	}
	return 0;
}
