#include<iostream>
using namespace std;

bool isPrimeRecursive(int n, int i) {
    if (i > n / 2)
        return true;
        
    if (n % i == 0)
        return false;

    return isPrimeRecursive(n, i + 1);
}

int main() {
    int n;
    cout << "Enter a number: ";
    cin >> n;

    if (n < 2) {
        cout << "It is not a prime number";
    } else {
        if (isPrimeRecursive(n, 2))
            cout << n << " is a prime number.";
        else
            cout << n << " is not a prime number.";
    }

    return 0;
}
